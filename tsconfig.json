{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "**/templates/*",
    "**/node_modules/*",
    "**/dist/*",
    "node_modules/*",
    "**/storybook-static/*",
    "libraries/**/node_modules/*",
    "libraries/**/dist-theme/*",
    "libraries/**/design/*",
    "packages/**/node_modules/*",
    "packages/**/dist/*",
    "setters/node_modules/*",
  ]
}
