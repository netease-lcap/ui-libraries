{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "declaration": true,
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "alwaysStrict": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "ide/**/*.ts",
    "src/components/van-absolute-layout/stories/block.stories.js",
    "src/components/van-flex/stories/block.stories.js",
    "src/components/van-search/stories/block.stories.js"
  ],
  "exclude": [
    "**/templates",
    "**/node_modules",
    "**/dist",
    "**/dist-theme",
    "**/es",
    "node_modules",
    "dist",
    "dist-theme",
    "es",
    "coverage",
    "**/storybook-static",
    "**/coverage"
  ],
  "references": []
}
