{
  "name": "@lcap/element-plus",
  "version": "1.0.0-beta.1",
  "author": "NetEase CodeWave FE Team",
  "main": "dist-theme/index.js",
  "style": "dist-theme/index.css",
  "repository": "https://github.com/netease-lcap/ui-libraries",
  "bugs": {
    "url": "https://github.com/netease-lcap/ui-libraries/issues"
  },
  "homepage": "https://github.com/netease-lcap/ui-libraries#readme",
  "files": [
    "dist-theme",
    "es",
    "lib",
    "src",
    "manifest.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist-theme/index.mjs",
      "require": "./dist-theme/index.cjs",
      "default": "./dist-theme/index.js"
    }
  },
  "scripts": {
    "dev": "npm run storybook",
    "storybook": "storybook dev -p 8008",
    "build": "lcap-scripts build",
    "create": "lcap-scripts create",
    "watch": "lcap-scripts watch",
    "deploy": "lcap-scripts deploy",
    "deploy:one": "lcap-scripts deploy --images",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:api": "tsc -p tsconfig.api.json",
    "test": "echo \"no test config\"",
    "test:dev": "vitest dev",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "Vue3"
  ],
  "license": "MIT",
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.2",
    "@lcap/builder": "workspace:*",
